# --------------------------------------------------------
# FIAP Hackathon — .env raiz (consumido pelo docker-compose
# na raiz do workspace). Copie este arquivo para `.env` e
# preencha os segredos. NUNCA comite `.env`.
# --------------------------------------------------------

# === MySQL local (docker-compose) ===
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=fiap_hackathon
MYSQL_USER=hackathon
MYSQL_PASSWORD=hackathonpass

# === MongoDB local (docker-compose) ===
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootpass
MONGO_DATABASE=fiap_hackathon_processing

# === MongoDB Atlas (cloud, fora do docker-compose) ===
# Formato: mongodb+srv://<user>:<senha>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_ATLAS_URI=

# === LocalStack (S3, SQS, SNS, Secrets Manager) ===
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET_RAW=fiap-hackathon-dev-uploads

# === Provedores LLM ===
LLM_VISION_PROVIDER=mock
LLM_TEXT_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=

# === Autenticação ===
JWT_SECRET=dev-jwt-secret-change-me-please-please
JWT_TTL_SECONDS=3600

# === Datadog (desligado por padrão; habilitar com --profile observability) ===
DD_API_KEY=
DD_SITE=datadoghq.com
